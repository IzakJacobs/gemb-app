Options -Indexes -MultiViews
DirectoryIndex index.php
AcceptPathInfo Off
Require all denied
<FilesMatch "^(index|api|asset|assistant|assistants|capture-api|owner|emails)\.php$">
 Require all granted
</FilesMatch>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://gemb.co.za%{REQUEST_URI} [R=301,L]
